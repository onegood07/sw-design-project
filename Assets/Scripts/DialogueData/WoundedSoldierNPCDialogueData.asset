    shouldStartSubmission: 1
    hasChoices: 0
    choices: []
    nextNodeIndex: 4
  - text: " \uC800\uB97C... \uC8FD\uAC8C... \uB0B4\uBC84\uB824\uB450\uC2DC\uACA0\uAD70\uC694..."
    typingSpeed: 0.05
